<body>
  <header class="site-header">
    <div class="container branding">
      <div>
        <h1>JavaScript Challenges</h1>
        <p>Try a quick level to sharpen your skills</p>
      </div>
    </div>

    <nav class="site-nav" aria-label="Main navigation">
