  <main class="site-main container">
    <section class="card">
      <h2>Level 1 — Variables</h2>
      <!-- Instructions -->
      <p>Write the value of the variable `name` to the console:</p>
      <div>
        <!-- Text area for user to type JavaScript (demo only) -->
        <label for="code">Your code</label>
        <textarea id="code" rows="8" placeholder="Type JavaScript here..." class="code-box"></textarea>
      </div>
      <div style="margin-top:12px">
        <button class="btn" id="runBtn">Run (demo)</button>
        <button class="btn" id="submitBtn">Submit (demo)</button>
      </div>
      <!-- Output window -->
      <div style="margin-top:14px">
        <h3>Output</h3>
        <div class="card">
          <pre id="output" style="white-space:pre-wrap">Console output will appear here (demo).</pre>
        </div>
      </div>
    </section>
  </main>

